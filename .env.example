# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# The application has no credential defaults on purpose: application.yml reads
# ${DB_USERNAME} and ${DB_PASSWORD} with no fallback, so it fails loudly at
# startup rather than quietly running on a password that sits in version
# control. Keep it that way.

# Used by compose.yml to create the database.
POSTGRES_USER=budgettracker
POSTGRES_PASSWORD=change-me-locally

# Read by the backend. The same values as above: the backend signs in to the
# database this file created.
DB_USERNAME=budgettracker
DB_PASSWORD=change-me-locally

# Optional. Defaults to jdbc:postgresql://localhost:5432/budgettracker, which is
# exactly what compose.yml publishes, so it is only needed if you move the
# database somewhere else.
# DB_URL=jdbc:postgresql://localhost:5432/budgettracker
